# Salin menjadi .env. JANGAN bagikan file ini ke siapa pun.
#
# Kunci enkripsi untuk API key yang disimpan di database.
# Dibuat otomatis oleh `python -m bot init`. SIMPAN CADANGANNYA — jika hilang, API key harus dimasukkan ulang.
BOT_MASTER_KEY=

# Database. Kosongkan untuk SQLite (file data/bot.db). Contoh PostgreSQL:
# DATABASE_URL=postgresql+psycopg://botuser:passwordnya@localhost:5432/indodax_bot
DATABASE_URL=

# API key Indodax & Telegram kini diisi lewat halaman Pengaturan di dashboard web.
# (Jika diisi di sini, `python -m bot init` akan memindahkannya ke database secara terenkripsi.)
INDODAX_API_KEY=
INDODAX_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
