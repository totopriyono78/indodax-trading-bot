# Salin menjadi .env lalu isi. JANGAN bagikan file ini ke siapa pun.
# API key harus key TAPI v2 (buat di https://indodax.com/trade_api),
# izin: View + Trade saja (TANPA Withdraw), IP whitelist = IP publik VPS.
INDODAX_API_KEY=
INDODAX_SECRET_KEY=

# Opsional — notifikasi Telegram (lihat README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard web — wajib diisi jika dashboard.host bukan 127.0.0.1
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
